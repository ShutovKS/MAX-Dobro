<VerificationPlan VERSION="1.0.0">
  <GlobalPolicy>
    <log-format>[Module][function][BLOCK_NAME] message</log-format>
    <deterministic-first>true</deterministic-first>
    <module-level-focus>Jest unit tests next to Nest services and controllers.</module-level-focus>
    <wave-level-focus>backend/test e2e specs for the HTTP surfaces touched by a change.</wave-level-focus>
    <phase-level-focus>backend build plus frontend build; e2e when the database is available.</phase-level-focus>
    <autonomy-gate>Critical backend modules need commands, success/failure scenarios, and existing tests before long autonomous execution. Frontend currently has no automated tests; UI changes need mock-mode manual or browser checks.</autonomy-gate>
    <redaction>Never log secrets, credentials, raw tokens, MAX/Telegram init data, or webhook secrets.</redaction>
  </GlobalPolicy>

  <CriticalFlows>
    <VF-001 NAME="AuthenticateAndLoadProfile" USE_CASES="UC-003" DATA_FLOW="DF-AUTH" PRIORITY="high">
      <scenario>Valid login yields a session; GET /profile/me returns the same user.</scenario>
      <expected-outcome>HTTP success with token and profile fields; unauthorized without token.</expected-outcome>
      <required-signals>
        <log-marker>[Auth][loginWithMax][BLOCK_ISSUE_JWT]</log-marker>
        <trace-sequence>BLOCK_VALIDATE_INIT_DATA -&gt; BLOCK_UPSERT_USER -&gt; BLOCK_ISSUE_JWT</trace-sequence>
      </required-signals>
    </VF-001>
    <VF-002 NAME="DiscoverAndJoinEvent" USE_CASES="UC-001" DATA_FLOW="DF-EVENT-DISCOVERY,DF-EVENT-PARTICIPATE" PRIORITY="high">
      <scenario>Volunteer lists events and participates.</scenario>
      <expected-outcome>GET /events returns items; participate creates EventParticipant.</expected-outcome>
      <required-signals>
        <log-marker>[Events][participate][BLOCK_PARTICIPATE]</log-marker>
      </required-signals>
    </VF-002>
    <VF-003 NAME="OrganizerManagesParticipants" USE_CASES="UC-002" DATA_FLOW="DF-ORG-MANAGE-EVENT" PRIORITY="high">
      <scenario>Organizer creates or updates an event and patches participant status.</scenario>
      <expected-outcome>Only organizer-bound users succeed; volunteer gets 403 on organizer routes.</expected-outcome>
      <required-signals>
        <log-marker>[Events][updateParticipant][BLOCK_UPDATE_STATUS]</log-marker>
      </required-signals>
    </VF-003>
    <VF-004 NAME="CompleteCourseProgress" USE_CASES="UC-004" DATA_FLOW="DF-LEARNING" PRIORITY="high">
      <scenario>Lesson and course completion persist on the server.</scenario>
      <expected-outcome>Progress arrays and certificate records survive a new session.</expected-outcome>
      <required-signals>
        <log-marker>[Learning][completeLesson][BLOCK_COMPLETE_LESSON]</log-marker>
      </required-signals>
    </VF-004>
    <VF-005 NAME="MockThenRealFrontend" USE_CASES="UC-001,UC-003" DATA_FLOW="DF-EVENT-DISCOVERY" PRIORITY="medium">
      <scenario>Frontend route shell works in VITE_API_MODE=mock, then real when API is up.</scenario>
      <expected-outcome>Auth and home routes render; adapter switch does not change export names.</expected-outcome>
      <required-signals>
        <log-marker>[FrontendApi][selectAdapter][BLOCK_SELECT_ADAPTER]</log-marker>
      </required-signals>
    </VF-005>
  </CriticalFlows>

