  <DataFlow>
    <DF-AUTH NAME="AuthenticateSession" TRIGGER="Login screen or messenger init data">
      <step-1>M-FRONTEND-AUTH or M-FRONTEND-TELEGRAM / M-FRONTEND-MAX collects credentials or init data</step-1>
      <step-2>M-AUTH verifies provider payload and upserts User via M-PRISMA</step-2>
      <step-3>M-AUTH issues an internal JWT; M-FRONTEND-APP restores the session</step-3>
      <evidence>[Auth][loginWithMax][BLOCK_ISSUE_JWT] or auth e2e success</evidence>
    </DF-AUTH>
    <DF-EVENT-DISCOVERY NAME="DiscoverEvents" TRIGGER="Home tab or map">
      <step-1>M-FRONTEND-SCREENS calls M-FRONTEND-API fetchAllEvents or fetchMapMarkers</step-1>
      <step-2>M-EVENTS or M-MAP query M-PRISMA</step-2>
      <step-3>UI renders EventCard or InteractiveMap</step-3>
      <evidence>events e2e GET /events returns seeded events</evidence>
    </DF-EVENT-DISCOVERY>
    <DF-EVENT-PARTICIPATE NAME="JoinEvent" TRIGGER="Event detail participate">
      <step-1>M-FRONTEND-API participateInEvent</step-1>
      <step-2>M-EVENTS writes EventParticipant through M-PRISMA</step-2>
      <evidence>[Events][participate][BLOCK_PARTICIPATE]</evidence>
    </DF-EVENT-PARTICIPATE>
    <DF-ORG-MANAGE-EVENT NAME="OrganizerManagesEvent" TRIGGER="Organizer dashboard">
      <step-1>M-FRONTEND-SCREENS organizer pages call organizer API helpers</step-1>
      <step-2>M-EVENTS and M-ORGANIZATIONS enforce organizer role</step-2>
      <step-3>Participant status updates persist</step-3>
      <evidence>organizations e2e dashboard and events e2e participant patch</evidence>
    </DF-ORG-MANAGE-EVENT>
    <DF-LEARNING NAME="CompleteCourse" TRIGGER="Lesson or course complete">
      <step-1>M-FRONTEND-API markLessonComplete or completeCourse</step-1>
      <step-2>M-LEARNING updates UserCourseProgress and may issue UserCertificate</step-2>
      <evidence>learning e2e complete endpoints</evidence>
    </DF-LEARNING>
    <DF-STORY NAME="PublishStory" TRIGGER="Create story screen">
      <step-1>M-FRONTEND-API createStory</step-1>
      <step-2>M-STORIES inserts Story via M-PRISMA</step-2>
      <evidence>stories e2e POST /stories</evidence>
    </DF-STORY>
    <DF-REWARD NAME="PurchaseReward" TRIGGER="Rewards shop">
      <step-1>M-FRONTEND-API purchaseReward</step-1>
      <step-2>M-REWARDS deducts karma and writes UserReward</step-2>
      <evidence>rewards e2e purchase</evidence>
    </DF-REWARD>
    <DF-ASSISTANT NAME="AssistantMessage" TRIGGER="Assistant chat screen">
      <step-1>M-FRONTEND-API postAssistantMessage</step-1>
      <step-2>M-ASSISTANT-CHAT stores user and assistant rows</step-2>
      <evidence>assistant-chat e2e</evidence>
    </DF-ASSISTANT>
    <DF-WEBHOOK-SYNC NAME="SupabaseUserSync" TRIGGER="Supabase auth webhook">
      <step-1>M-WEBHOOKS validates secret</step-1>
      <step-2>User upsert through M-PRISMA</step-2>
      <evidence>[Webhooks][handleSupabaseAuth][BLOCK_UPSERT_USER]</evidence>
    </DF-WEBHOOK-SYNC>
    <DF-BOT-LAUNCH NAME="MessengerLaunch" TRIGGER="Bot start command">
      <step-1>M-BOT-MAX or M-BOT-TELEGRAM answers start</step-1>
      <step-2>User opens mini-app URL or web_app button</step-2>
      <evidence>Bot process stays alive and answers /start without throwing on missing tokens in production config</evidence>
    </DF-BOT-LAUNCH>
    <DF-LEADERBOARD NAME="ViewLeaderboard" TRIGGER="Leaderboard screen">
      <step-1>M-FRONTEND-API fetchLeaderboardData</step-1>
      <step-2>M-LEADERBOARD ranks users</step-2>
      <evidence>leaderboard unit and e2e</evidence>
    </DF-LEADERBOARD>
    <DF-SOCIAL NAME="FriendsAndEventChat" TRIGGER="Friends or event chat screens">
      <step-1>M-FRONTEND-API fetchFriends or event chat calls</step-1>
      <step-2>M-FRIENDS or M-EVENT-CHATS query M-PRISMA</step-2>
      <evidence>friends and event-chats specs</evidence>
    </DF-SOCIAL>
  </DataFlow>

