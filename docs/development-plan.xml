<DevelopmentPlan VERSION="1.0.0">
  <ArchitectureNotes>
    <objective>Make the existing MAX Dobro codebase navigable for agents via GRACE contracts, graph links, and verification refs without changing runtime behavior.</objective>
    <non-goal>Do not redesign APIs, add features, or replace mock/real adapters while applying markup.</non-goal>
    <risk-1>Auth identity linking across MAX, Telegram, and Supabase can drift if one path writes users the others cannot find.</risk-1>
    <risk-2>Frontend mock mode can hide contract mismatches until real API mode is used.</risk-2>
    <note-retroactive>This plan documents the shipped architecture. Phase status is done; remaining work is markup and graph hygiene.</note-retroactive>
  </ArchitectureNotes>

  <Modules>
    <M-BACKEND-BOOTSTRAP NAME="BackendBootstrap" TYPE="ENTRY_POINT" LAYER="2" ORDER="1" STATUS="implemented">
      <contract>
        <purpose>Create the NestJS HTTP app, CORS, validation pipe, Swagger, and listen port.</purpose>
        <inputs>
          <param name="env.PORT" type="string" />
        </inputs>
        <outputs>
          <param name="listeningServer" type="INestApplication" />
        </outputs>
        <errors>
          <error code="BOOTSTRAP_FAILED" />
        </errors>
      </contract>
      <interface>
        <export-bootstrap PURPOSE="Start the API process" />
      </interface>
      <depends>M-BACKEND-APP</depends>
      <target>
        <source>backend/src/main.ts</source>
        <tests>backend/test/general.e2e-spec.ts</tests>
      </target>
      <observability>
        <log-prefix>[BackendBootstrap]</log-prefix>
        <critical-block>BLOCK_LISTEN</critical-block>
      </observability>
      <verification-ref>V-M-BACKEND-BOOTSTRAP</verification-ref>
    </M-BACKEND-BOOTSTRAP>

