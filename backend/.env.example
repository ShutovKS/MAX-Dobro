# Порт сервера (на сервере 3000 занят — используем 3001)
PORT=3001

# Токен Telegram-бота от @BotFather (для проверки входа через Telegram Mini App)
TELEGRAM_BOT_TOKEN="ВАШ_ТОКЕН_БОТА_ОТ_BOTFATHER"

# (Опционально) Токен бота MAX — MAX-режим оставлен спящим
MAX_BOT_TOKEN="not-used-telegram-edition"

# URL вашего мини-приложения
MINI_APP_URL="https://dobroclub.online"

# Сгенерируйте: openssl rand -base64 32  (или node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JWT_INTERNAL_SECRET="ВАШ_СГЕНЕРИРОВАННЫЙ_КЛЮЧ"

# Supabase connection string (Project Settings -> Database). Пароль БД подставьте сами.
# DATABASE_URL — транзакционный пулер (рантайм), DIRECT_URL — сессионный (миграции).
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase API (Project Settings -> API)
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_ANON_KEY="ВАШ_АНОНИМНЫЙ_КЛЮЧ_SUPABASE"
SUPABASE_WEBHOOK_SECRET="ПРИДУМАЙТЕ_СЕКРЕТ_И_УКАЖИТЕ_В_SUPABASE_WEBHOOK"
